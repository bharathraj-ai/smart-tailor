// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String?
  phone     String?  @unique
  role      String   @default("customer")
  address   String?
  createdAt DateTime @default(now())

  measurements Measurement[]
  orders       Order[]
}

model Measurement {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  name         String
  chest        Float?
  waist        Float?
  hip          Float?
  shoulder     Float?
  sleeveLength Float?
  neckSize     Float?
  height       Float?
  createdAt    DateTime @default(now())

  orderItems   OrderItem[]
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  image       String?
  createdAt   DateTime @default(now())
}

model Order {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  status        String
  paymentMethod String
  paymentStatus String
  totalAmount   Float
  deliveryType  String
  deliveryAddress String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items         OrderItem[]
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id])
  category      String
  measurementId String?
  measurement   Measurement? @relation(fields: [measurementId], references: [id])
  createdAt     DateTime @default(now())
}

model Image {
  id        String   @id @default(cuid())
  data      String   // Base64 text
  createdAt DateTime @default(now())
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  images    Json?    // Storing the image array
  createdAt DateTime @default(now())
}
